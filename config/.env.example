# LLM API 配置（复制为 .env 并填入你的 API Key）
# ------------------------------------------------------------------
# 支持两种接法，二选一：
#
#  [A] DeepSeek 官方
#      DEEPSEEK_API_KEY=<你的 Key>
#      DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
#      DEEPSEEK_MODEL=deepseek-chat        # 或 deepseek-reasoner
#      获取地址：https://platform.deepseek.com/api_keys
#
#  [B] OpenAI 兼容网关（本项目实测可用）
#      DEEPSEEK_API_KEY=<网关下发的 Key>
#      DEEPSEEK_BASE_URL=https://amr-link.open-design.ai/v1
#      DEEPSEEK_MODEL=deepseek-v4.1-flash
#
# 变量读取优先级：LLM_* > DEEPSEEK_*，显式构造参数优先级最高。
# 若 base_url 或 model 填错，通常表现为 404 或 "model not found"。
# ------------------------------------------------------------------
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

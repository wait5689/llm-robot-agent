<?xml version="1.0"?>
<!--
  advanced_robot.urdf —— 差速驱动移动机器人（v3 重建版）
  ==========================================================
  v2 的问题（都是实测踩出来的，不是纸上推演）：

  1. 四轮车却只有前轮一对被 diff_drive 驱动，后轮纯滚动无动力。
     Noetic 的 gazebo_ros_diff_drive 每侧只接受「一个」关节名，
     写 "left_front_joint, left_rear_joint" 这种逗号列表时，
     插件拿整串去 GetJoint() 必然找不到，然后在 Load 里静默 return：
     没有报错、没有日志，但 /odom 和 /cmd_vel 都不存在。
     → v3 改成标准两轮差速 + 前后各一个万向球（caster），
       每侧一个驱动轮，物理上自洽。

  2. 激光雷达被埋在传感器平台内部。
     平台碰撞体 r=0.12、高 0.08，在平台坐标系里占 z∈[0.01,0.09]；
     激光 joint 的 origin z=0.08，正好落在平台内部且与平台同轴，
     720 条水平光束全部打在平台内壁上，每条读数都是 0.10~0.15m。
     AMCL 拿这种扫描无法匹配地图，粒子不收敛，map->odom 永不广播。
     → v3 把雷达抬到平台顶面以上，并缩小平台半径。

  3. base_link 带惯性被 KDL 警告（root link with inertia）。
     → v3 增加 base_footprint 作为根 link，固定连接 base_link。

  关键尺寸（改这里要同步改 config/costmap_common_params.yaml 的 footprint）：
    - 底盘 0.52 x 0.42 x 0.16 m
    - 轮半径 0.08 m，轮距 0.40 m（左右轮中心间距）
    - 激光安装高度 z=0.34 m，扫描平面高于平台顶面
    - 整体外廓约 0.60 x 0.52 x 0.42 m，内切半径 0.30 m
-->
<robot name="advanced_robot">

  <!-- ============================================================
       根坐标系：base_footprint（地面投影，z=0）
       robot_state_publisher 需要一棵没有循环、根节点无惯性的树。
       ============================================================ -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.10"/>
  </joint>

  <!-- ============================================================
       底盘
       ============================================================ -->
  <link name="base_link">
    <visual>
      <!--
        ★ 底盘尺寸与位置是踩过坑的，改动前务必读完这段：
        v3 最初写成 0.52 x 0.42 x 0.16，中心 z=0.02（相对 base_link）。
        base_link 离地 0.10，于是底盘占地面以上 z∈[0.04,0.20]，
        横向 y∈[-0.21,0.21]；
        而驱动轮在 y=±0.20、半径 0.08、轮心 z=-0.02，
        其 y 跨 [0.17,0.23]、z 跨 [地面以上 0,0.16]。
        两者在 y 与 z 上同时重叠 —— 轮子物理上「长进」了底盘里。
        万向球同理：球心 z=-0.065、半径 0.035，顶点 z=-0.030，
        而底盘底面 z=-0.06，也插进去 0.03。

        Gazebo 不会因此报错，但它会持续求解这些穿透接触力，
        表现为：差速转向时轮子被底盘「拖住」，
        实际转角只有指令的 87%（实测 1.381 vs 1.587 rad），
        而这个偏差全部进了轮式里程计 → odom 航向虚增 15%
        → AMCL 每走一段就跟丢，误差单调增长到数米，
        move_base 却在错误位姿上报告 SUCCEEDED（假成功）。

        现在的尺寸：底盘 0.52 x 0.32 x 0.16，中心 z=0.06，
        即地面以上 z∈[0.08,0.24]，横向 y∈[-0.16,0.16]，
        与轮子（y≥0.17）、万向球（顶点 -0.03 < 底面 -0.04）都不再相交。
      -->
      <origin xyz="0 0 0.08"/>
      <geometry>
        <box size="0.52 0.32 0.16"/>
      </geometry>
      <material name="chassis_blue">
        <color rgba="0.18 0.35 0.62 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.08"/>
      <geometry>
        <box size="0.52 0.32 0.16"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="4.0"/>
      <origin xyz="0 0 0.08"/>
      <inertia ixx="0.032" ixy="0" ixz="0" iyy="0.042" iyz="0" izz="0.052"/>
    </inertial>
  </link>

  <!-- 底盘装饰条（纯视觉，无碰撞，避免影响膨胀） -->
  <link name="chassis_trim">
    <visual>
      <origin xyz="0 0 0.16"/>
      <geometry>
        <box size="0.53 0.33 0.02"/>
      </geometry>
      <material name="trim_dark">
        <color rgba="0.10 0.10 0.12 1"/>
      </material>
    </visual>
  </link>
  <joint name="chassis_trim_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_trim"/>
  </joint>

  <!-- ============================================================
       传感器平台
       【关键】半径从 0.12 缩到 0.09，高度压到 0.05，
       并让激光装在它「上面」而不是「里面」。
       ============================================================ -->
  <link name="sensor_platform">
    <visual>
      <origin xyz="0 0 0.025"/>
      <geometry>
        <cylinder radius="0.09" length="0.05"/>
      </geometry>
      <material name="platform_grey">
        <color rgba="0.55 0.55 0.58 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.025"/>
      <geometry>
        <cylinder radius="0.09" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.30"/>
      <inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.0006"/>
    </inertial>
  </link>
  <joint name="sensor_platform_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_platform"/>
    <!-- 底盘 collision 占 base_link z∈[0.00,0.16]，
         平台自身占本系 z∈[0,0.05]，故 joint z=0.16 正好叠在顶面上。 -->
    <origin xyz="0 0 0.16"/>
  </joint>

  <!-- ============================================================
       激光雷达
       平台占 z∈[0.10,0.15]（base_link 系），雷达中心放在 z=0.24，
       高出平台顶面 0.09m，扫描平面完全脱离遮挡。
       ============================================================ -->
  <link name="laser_link">
    <visual>
      <geometry>
        <cylinder radius="0.045" length="0.05"/>
      </geometry>
      <material name="laser_red">
        <color rgba="0.80 0.18 0.15 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.045" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.18"/>
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0004"/>
    </inertial>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="sensor_platform"/>
    <child link="laser_link"/>
    <!--
      ★ 这里是 v2 的头号 bug。sensor_platform 坐标系原点在 base_link 的
      z=0.10 处，平台圆柱占本坐标系 z∈[0,0.05]。原写法 origin z=0.08
      让雷达中心落在平台上方 0.08（= base_link 系 0.18），但平台顶面在
      0.05，两者相距仅 0.03，加上雷达自身高 0.05，
      其下缘 0.055 与平台顶面 0.05 几乎贴合；更要命的是雷达与平台同轴，
      水平扫描线擦着平台侧面过去，720 条光束全部打在 0.09m 平台上。
      现在抬到 origin z=0.14（= base_link 系 0.24），
      雷达下缘 0.115 高出平台顶面 0.05 共 0.065m，完全无遮挡。
    -->
    <origin xyz="0 0 0.08"/>
  </joint>

  <!-- ============================================================
       摄像头（视觉用，朝向 +X）
       ============================================================ -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.06 0.10 0.05"/>
      </geometry>
      <material name="camera_black">
        <color rgba="0.10 0.10 0.12 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.06 0.10 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.10"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="sensor_platform"/>
    <child link="camera_link"/>
    <origin xyz="0.09 0 0.025"/>
  </joint>

  <!-- ============================================================
       驱动轮（左右各一，真正的差速驱动）
       轮中心 x=0，轮距 0.40m，半径 0.08m
       ============================================================ -->
  <link name="left_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.06"/>
      </geometry>
      <material name="wheel_black">
        <color rgba="0.08 0.08 0.09 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.35"/>
      <inertia ixx="0.0012" ixy="0" ixz="0" iyy="0.0012" iyz="0" izz="0.0012"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <!-- base_link 原点距地 0.10，轮半径 0.08，故轮心 z = 0.08-0.10 = -0.02 -->
    <origin xyz="0 0.20 -0.02"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.06"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.35"/>
      <inertia ixx="0.0012" ixy="0" ixz="0" iyy="0.0012" iyz="0" izz="0.0012"/>
    </inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.20 -0.02"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ============================================================
       万向轮（前后各一，纯支撑，摩擦极低）
       差速车必须靠万向轮支撑才稳，否则会前后点头。
       ============================================================ -->
  <link name="caster_front">
    <visual>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <material name="caster_grey">
        <color rgba="0.60 0.60 0.62 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>
  <joint name="caster_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_front"/>
    <!-- 球半径 0.035；base_link 离地 0.10，球心 z=-0.065 即离地 0.035，
         球顶 = -0.065+0.035 = -0.030，底盘底面 = 0.06-0.08 = -0.020，
         球顶低于底面，不再插进底盘。 -->
    <origin xyz="0.22 0 -0.065"/>
  </joint>

  <link name="caster_rear">
    <visual>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <material name="caster_grey"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>
  <joint name="caster_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_rear"/>
    <origin xyz="-0.22 0 -0.065"/>
  </joint>

  <!-- ============================================================
       Gazebo 差速驱动插件
       ============================================================
       参数名以 /opt/ros/noetic/lib/libgazebo_ros_diff_drive.so
       实测键名为准（strings 核对），三类坑都真实踩过：

       1) 键名风格不统一：
            leftJoint / rightJoint（驼峰，不是 left_joint）
            wheelSeparation / wheelDiameter / wheelTorque / wheelAcceleration
            commandTopic / odometryTopic / odometryFrame / robotBaseFrame
            publishTf / publishOdomTF / publishWheelTF / publishWheelJointState
            updateRate / alwaysOn
          写成 <left_joint> 会打印 "missing <leftJoint> default is left_joint"。

       2) odometrySource 是枚举，只能填 encoder 或 world。
          填 1 会报 "<odometrySource> no matching key to 1"。

       3) leftJoint / rightJoint 每侧只能一个关节名，不能是逗号列表。
          写成列表时插件 GetJoint() 失败并静默 return ——
          不报错、不打日志，但 /odom 与 /cmd_vel 都不存在。
          这是最难查的一个，v3 用两轮结构从根上避免。

       缺 publishTf 的后果链条：
         /odom 不发布 → odom->base_link 不广播 → AMCL 无 odom
         → map 坐标系永不出现 → move_base 一直
           "target_frame map does not exist"
       ============================================================ -->
  <gazebo>
    <plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <rosDebugLevel>Debug</rosDebugLevel>
      <alwaysOn>true</alwaysOn>
      <updateRate>100.0</updateRate>

      <!-- 每侧一个驱动轮关节 -->
      <leftJoint>left_wheel_joint</leftJoint>
      <rightJoint>right_wheel_joint</rightJoint>

      <!--
  ## wheelSeparation = 两轮中心几何距，不要拿它当标定旋钮。

  几何上两轮中心距 = 0.40m（joint 在 y=+-0.20）。
  diff_drive 插件用这个值做两件事：
    1) 把 cmd_vel.angular.z 换算成两轮转速
    2) 把编码器读数换算回航向

  取值演化（全部为 Gazebo 实测，方法见 tools/ 下的标定脚本）：

    0.40  纯几何     truth 1.5053 / 期望 1.5708 (-4.2%)
                     odom 1.5763 -> odom/truth = 1.148
                     车体转不够，里程计虚报 15%，AMCL 长距离必跟丢

    0.42  几何微调   odom/truth = 0.9965（里程计准）
                     truth 仍 -3.1%（车体依旧转不够）

    0.432 + 修摩擦  truth 准了（-2.1% / +0.5% / +1.1%）
                     但 odom/truth = 0.973（反而低估）

    0.42  + 修摩擦  物理与里程计同时正确  <== 当前取值

  关键教训：
    「车体转不够」与「里程计虚报」同时出现时，
    不要用 wheelSeparation 去补偿 —— 那只是把误差换个方向，
    AMCL 一样会跟丢（症状是 state=3 成功但真值差数米）。
    应该先消除物理阻力（万向球摩擦、接触刚度），
    再用几何真值。

  自检方法：让机器人在空旷处原地转 2-pi，
      物理转角 / 期望       应在 +-2% 内
      odom / truth          应接近 1.000
    两个比值同时成立，才说明机器人模型可以用于导航。
-->
<wheelSeparation>0.42</wheelSeparation>
      <wheelDiameter>0.16</wheelDiameter>
      <wheelTorque>40</wheelTorque>
      <wheelAcceleration>12.0</wheelAcceleration>

      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_footprint</robotBaseFrame>
      <!-- 枚举值只能是 encoder 或 world -->
      <odometrySource>encoder</odometrySource>

      <!-- 关键：缺 publishTf 时 odom->base_link 不会广播 -->
      <publishTf>true</publishTf>
      <publishOdomTF>true</publishOdomTF>
      <!-- 关闭：轮子 TF 交给 robot_state_publisher，避免重复时间戳 -->
      <publishWheelTF>false</publishWheelTF>
      <publishWheelJointState>true</publishWheelJointState>
    </plugin>
  </gazebo>

  <!-- ============================================================
       万向轮摩擦：必须接近零，否则差速转向会被拖住
       ============================================================ -->
  <!--
    ★ 万向球摩擦不能设成接近 0。
    v3 初版写 mu=0.001，本意是「让球顺滑滚动」，
    但 Gazebo 的 ODE 求解器在 mu≈0 时会把球当成理想无摩擦支撑：
    机器人靠两个驱动轮 + 两个「冰面」支撑，
    转向时车身绕前方冰球滑移，驱动轮虽然转了 1.577 rad，
    车体实际只转 1.374 rad —— 缺的 12% 全是车身滑移。

    正确做法：球摩擦取中等值（0.1），
    既能让球在直行时正常滚动（球会自转，不会拖住车身），
    又能在转向时提供足够的横向约束。
    kp/kd 一并降低，避免球与地面硬碰产生弹跳。
  -->
  <gazebo reference="caster_front"> 
    <!-- 万向球转向阻力是「车体转不够」的主因。
         实测每转 180 度少转 3.1%（3.0435 vs 3.1416 rad），
         这部分缺口让 AMCL 拿到偏小的航向增量，
         长距离直行后横向偏出，最终 AMCL 报成功而真值差近 1m。

         mu1 低 / mu2 高 是有意的各向异性设置：
           mu1 方向给低值，允许球体在转向时自由侧滑
           mu2 方向给高值，保证整车不会像在冰面上一样漂移
         kp/kd 同时降低，避免球与地面硬碰产生高频弹跳
         （弹跳的宏观表现也是「打滑」）。 -->
    <mu1>0.02</mu1>
    <mu2>0.25</mu2>
    <kp>50000.0</kp>
    <kd>100.0</kd>
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="caster_rear"> 
    <!-- 万向球转向阻力是「车体转不够」的主因。
         实测每转 180 度少转 3.1%（3.0435 vs 3.1416 rad），
         这部分缺口让 AMCL 拿到偏小的航向增量，
         长距离直行后横向偏出，最终 AMCL 报成功而真值差近 1m。

         mu1 低 / mu2 高 是有意的各向异性设置：
           mu1 方向给低值，允许球体在转向时自由侧滑
           mu2 方向给高值，保证整车不会像在冰面上一样漂移
         kp/kd 同时降低，避免球与地面硬碰产生高频弹跳
         （弹跳的宏观表现也是「打滑」）。 -->
    <mu1>0.02</mu1>
    <mu2>0.25</mu2>
    <kp>50000.0</kp>
    <kd>100.0</kd>
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- 驱动轮摩擦：给足抓地力 -->
  <gazebo reference="left_wheel">
    <!-- mu 2.0：橡胶轮在硬地面的实际摩擦系数。
         kp 从 1e6 降到 1e5：过硬的接触约束会让轮子在地面
         产生微小弹跳，宏观上表现为滚动距离偏短
         （实测直线 5s 少走 4.5%）。kd 相应提高以维持稳定性。 -->
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <kp>80000.0</kp>
    <kd>20.0</kd>
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="right_wheel">
    <!-- mu 2.0：橡胶轮在硬地面的实际摩擦系数。
         kp 从 1e6 降到 1e5：过硬的接触约束会让轮子在地面
         产生微小弹跳，宏观上表现为滚动距离偏短
         （实测直线 5s 少走 4.5%）。kd 相应提高以维持稳定性。 -->
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <kp>80000.0</kp>
    <kd>20.0</kd>
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- ============================================================
       激光雷达传感器
       量程 0.12~12m，720 线，30Hz。
       laser_max_range 在 amcl_params.yaml 里设为 9.0（< 12），
       避免无效读数把 AMCL 带偏。
       ============================================================ -->
  <gazebo reference="laser_link">
    <sensor type="ray" name="laser_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>30</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <!--
        ★ 这个插件不能漏。只写 <sensor type="ray"> 而不挂 ROS 转换插件时，
        Gazebo 内部照常渲染激光（GUI 里甚至能看到扫描线），
        但**不会**往 ROS 发布任何 /scan 话题。
        现象：/odom 正常、/cmd_vel 正常、机器人能开，
        唯独 /scan 完全不存在，AMCL 起不来、move_base 无输入。
        必须显式加载 libgazebo_ros_laser.so 才有 /scan。
      -->
      <plugin name="laser_plugin" filename="libgazebo_ros_laser.so">
        <topicName>scan</topicName>
        <frameName>laser_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ============================================================
       摄像头传感器
       ============================================================ -->
  <gazebo reference="camera_link">
    <sensor type="camera" name="camera_sensor">
      <update_rate>15.0</update_rate>
      <camera name="head">
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>20.0</far>
        </clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <cameraName>camera</cameraName>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <frameName>camera_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

</robot>

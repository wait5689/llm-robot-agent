<?xml version="1.0" ?>
<!--
  复杂室内环境 v2（由 tools/gen_world.py 生成，请勿手工编辑）

  布局：南区（活动区）+ 北区（三个房间），由一条走廊墙分隔，
        墙上开 3 个门洞保证南北连通；北区两道隔墙靠近走廊端各开一门。

  所有门宽 1.10m / 高 2.10m，墙高 2.5m。
  机器人直径 0.64m，门宽留有余量。
  修改布局请改生成器参数后重新生成，并用 tools/audit_world.py 校验。
-->
<sdf version="1.4">
  <world name="complex_indoor">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- 渲染：室内偏暗氛围 -->
    <scene>
      <ambient>0.18 0.18 0.22 1</ambient>
      <background>0.30 0.32 0.35 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- 太阳光（减弱，模拟室内透过窗户的自然光） -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- 地面 -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- 室内地砖（覆盖整个场地） -->
    <model name="floor_tile">
      <static>true</static>
      <pose>0 0 0.005 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>12.0 10.0 0.01</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>12.0 10.0 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.80 0.79 0.77 1</ambient>
            <diffuse>0.80 0.79 0.77 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 室内点光源（暖色吊灯，适度亮度） -->
    <light name="indoor_light_center" type="point">
      <pose>0 0 2.3 0 0 0</pose>
      <diffuse>0.70 0.65 0.55 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation>
        <range>10.0</range>
        <constant>0.6</constant>
        <linear>0.12</linear>
        <quadratic>0.02</quadratic>
      </attenuation>
      <cast_shadows>true</cast_shadows>
    </light>
    <light name="indoor_light_north" type="point">
      <pose>0 3.0 2.3 0 0 0</pose>
      <diffuse>0.65 0.60 0.50 1</diffuse>
      <attenuation>
        <range>7.0</range>
        <constant>0.7</constant>
        <linear>0.15</linear>
        <quadratic>0.02</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
    <light name="indoor_light_south" type="point">
      <pose>0 -3.0 2.3 0 0 0</pose>
      <diffuse>0.65 0.60 0.50 1</diffuse>
      <attenuation>
        <range>7.0</range>
        <constant>0.7</constant>
        <linear>0.15</linear>
        <quadratic>0.02</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- ============ 外墙 ============ -->
    <model name="wall_north_0">

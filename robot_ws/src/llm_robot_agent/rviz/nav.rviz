Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Map1
        - /LaserScan1
        - /Path1
      Splitter Ratio: 0.5
    Tree Height: 560
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Name: Tool Properties
    Property Tree Widget:
      Expanded:
        - /2D Pose Estimate1
        - /2D Nav Goal1
    Tree Height: 200
  - Class: rviz/Views
    Name: Views
    Expanded:
      - /Current View1
  - Class: rviz/Time
    Name: Time
    SyncMode: 0
    SyncSource: LaserScan

Visualization Manager:
  Class: ""
  Displays:
    # ---- 全局选项 ----
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Color: 160; 160; 164
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
      Value: true

    - Class: rviz/TF
      Name: TF
      Enabled: false
      Show Names: true
      Marker Scale: 0.6
      Update Interval: 0
      Value: false

    # ---- 地图 ----
    - Class: rviz/Map
      Name: Map
      Enabled: true
      Alpha: 0.7
      Color Scheme: map
      Draw Behind: true
      Topic: /map
      Value: true

    # ---- 激光 ----
    - Class: rviz/LaserScan
      Name: LaserScan
      Enabled: true
      Topic: /scan
      Color Transformer: FlatColor
      Color: 255; 80; 40
      Size (m): 0.03
      Style: Flat Squares
      Decay Time: 0
      Value: true

    # ---- 代价地图 ----
    - Class: rviz/Map
      Name: GlobalCostmap
      Enabled: false
      Alpha: 0.3
      Color Scheme: costmap
      Topic: /move_base/global_costmap/costmap
      Value: false

    - Class: rviz/Map
      Name: LocalCostmap
      Enabled: false
      Alpha: 0.4
      Color Scheme: costmap
      Topic: /move_base/local_costmap/costmap
      Value: false

    # ---- 规划路径 ----
    - Class: rviz/Path
      Name: GlobalPlan
      Enabled: true
      Topic: /move_base/NavfnROS/plan
      Color: 0; 170; 255
      Line Style: Lines
      Line Width: 0.04
      Value: true

    - Class: rviz/Path
      Name: LocalPlan
      Enabled: true
      Topic: /move_base/TrajectoryPlannerROS/local_plan
      Color: 0; 255; 120
      Line Style: Lines
      Line Width: 0.03
      Value: true

    # ---- 粒子云（AMCL 是否收敛，看这一项） ----
    - Class: rviz/PoseArray
      Name: ParticleCloud
      Enabled: true
      Topic: /particlecloud
      Color: 255; 170; 0
      Shape: Arrow (Flat)
      Length: 0.3
      Value: true

    # ---- AMCL 输出的当前位姿 ----
    - Class: rviz/PoseWithCovariance
      Name: AmclPose
      Enabled: true
      Topic: /amcl_pose
      Color: 0; 200; 0
      Value: true

    # ---- 机器人模型 ----
    - Class: rviz/RobotModel
      Name: RobotModel
      Enabled: true
      Robot Description: robot_description
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      Value: true

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30

  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    # 这两个是手动操作入口：
    #   2D Pose Estimate —— AMCL 重定位
    #   2D Nav Goal     —— 不经 Agent，直接给 move_base 发目标（阶段二验收用）
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal

  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Name: Current View
      Distance: 16
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 1.2
      Yaw: 0
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
  Displays:
    collapsed: false
  Views:
    collapsed: false

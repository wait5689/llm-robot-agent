<?xml version="1.0"?>
<package format="2">
  <name>llm_robot_agent</name>
  <version>0.2.0</version>
  <description>
    LLM-based Autonomous Mobile Robot Agent.
    A large language model plans tasks and drives a mobile robot through
    validated tool interfaces backed by the ROS navigation stack.
  </description>

  <maintainer email="2962103589@qq.com">wait5689</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- Navigation stack: localization + path planning + recovery -->
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf</depend>
  <depend>actionlib</depend>
  <depend>move_base_msgs</depend>
  <depend>rospy_message_converter</depend>

  <!-- Simulation -->
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>amcl</exec_depend>
  <exec_depend>map_server</exec_depend>
  <exec_depend>move_base</exec_depend>
  <exec_depend>rviz</exec_depend>

  <export>
  </export>
</package>

<?xml version="1.0"?>
<launch>
  <!-- ================= Gazebo ================= -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find four_car_sim)/worlds/complex_indoor.world"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="true"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>
  </include>

  <!-- ================= 读取高级机器人模型 ================= -->
  <param name="robot_description" textfile="$(find four_car_sim)/urdf/advanced_robot.urdf"/>

  <!-- ================= 在 Gazebo 中生成机器人 ================= -->
  <!-- 移到走廊中央开阔位置，远离墙壁 -->
  <node name="spawn_robot" pkg="gazebo_ros" type="spawn_model"
        args="-urdf -param robot_description -model advanced_robot -x 0 -y 0 -z 0.5 -R 0 -P 0 -Y 0"
        output="screen"/>

  <!-- ================= 关节状态 ================= -->
  <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher" output="screen"/>

  <!-- ================= TF ================= -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" output="screen"/>
</launch>
